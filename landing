<script>(function(){const checkoutBase = "https://app.makeugc.ai/auth/login?callbackUrl=https://app.makeugc.ai/subscription/first-time/";
const CREDIT_RATE = 100;

document.addEventListener("DOMContentLoaded", function () {
  const root = document.getElementById("pricing-v2");
  if (!root) return;

  const tabs = root.querySelectorAll("[data-hf-tab]");
  const toggle = root.querySelector("#billing-toggle");
  const periodTexts = root.querySelectorAll(".hf-period-text");
  let switchTimer;

  const monthlyPrices = {
    "papi-startup-pricing": 59,
    "papi-growth-pricing": 79,
    "papi-api-starter": 99,
    "papi-api-pro": 299,
  };

  const monthlyStrikePrices = {
    "papi-startup-pricing": 89,
    "papi-growth-pricing": 119,
    "papi-api-starter": 149,
    "papi-api-pro": 449,
  };

  const PRO_MONTHLY_CHECKOUT_BASE = checkoutBase;

  const PRO_YEARLY_CHECKOUT_BASE = PRO_MONTHLY_CHECKOUT_BASE;

  const PRO_YEARLY_TIERS = [
    {
      videos: 20,
      price: 79,
      strike: 149,
      yearlyUrl: PRO_YEARLY_CHECKOUT_BASE + "trial24h-yearly-pro-149",
    },
    {
      videos: 30,
      price: 99,
      strike: 199,
      yearlyUrl: PRO_YEARLY_CHECKOUT_BASE + "trial24h-yearly-pro-199",
    },
    {
      videos: 50,
      price: 129,
      strike: 249,
      yearlyUrl: PRO_YEARLY_CHECKOUT_BASE + "trial24h-yearly-pro-249",
    },
  ];

  const PRO_MONTHLY_TIERS = [
    {
      videos: 20,
      price: 1,
      strike: 149,
      renewNote: "Renews at $149",
      monthlyUrl: PRO_MONTHLY_CHECKOUT_BASE + "trial72h-pro-149-m",
    },
    {
      videos: 30,
      price: 1,
      strike: 199,
      renewNote: "Renews at $199",
      monthlyUrl: PRO_MONTHLY_CHECKOUT_BASE + "trial72h-pro-199-m",
    },
    {
      videos: 50,
      price: 1,
      strike: 249,
      renewNote: "Renews at $249",
      monthlyUrl: PRO_MONTHLY_CHECKOUT_BASE + "trial72h-pro-249-m",
    },
  ];

  const proCard = root.querySelector(".hf-v2-card.pro");
  const proPicker = root.querySelector("[data-pro-tier-picker]");
  const proRange = proPicker && proPicker.querySelector(".hf-pro-tier-range");
  const proFill = proPicker && proPicker.querySelector("[data-pro-tier-fill]");

  function getProTierIndex() {
    if (!proRange) return 0;
    return Number(proRange.value) || 0;
  }

  function syncProTier() {
    if (!proCard || !proPicker) return;

    const isYearly = !!(toggle && toggle.checked);
    const tiers = isYearly ? PRO_YEARLY_TIERS : PRO_MONTHLY_TIERS;
    const priceEl = proCard.querySelector(".papi-pro-pricing");
    const oldEl = proCard.querySelector(".hf-old-price");
    const btn = proCard.querySelector(".papi-btn-pro-pricing");
    const renewEl = proCard.querySelector("[data-pro-renew-note]");
    const periodEl = proCard.querySelector(".hf-period-text");
    const videosEl = proPicker.querySelector(".hf-pro-tier-videos");
    const fallback = tiers[0];
    const tier = tiers[getProTierIndex()] || fallback;
    const checkoutUrl = isYearly
      ? tier.yearlyUrl || fallback.yearlyUrl
      : tier.monthlyUrl || fallback.monthlyUrl;

    if (priceEl) priceEl.textContent = formatUsd(tier.price);
    if (oldEl) {
      if (tier.strike == null) {
        oldEl.style.display = "none";
      } else {
        oldEl.style.display = "";
        oldEl.textContent = formatUsd(tier.strike);
      }
    }
    if (renewEl) renewEl.textContent = isYearly ? "" : tier.renewNote || "";
    if (videosEl) videosEl.textContent = formatCreditsPerMonth(tier.videos);
    if (periodEl) periodEl.style.display = isYearly ? "" : "none";
    if (btn && checkoutUrl) btn.setAttribute("href", checkoutUrl);

    if (proFill && proRange) {
      const max = Number(proRange.max) || tiers.length - 1;
      proFill.style.width = max > 0 ? (getProTierIndex() / max) * 100 + "%" : "0%";
    }

    proPicker.querySelectorAll(".hf-pro-tier-tick").forEach(function (tick) {
      const idx = Number(tick.getAttribute("data-tier-index"));
      tick.classList.toggle("is-active", idx === getProTierIndex());
    });
    if (proRange) proRange.setAttribute("aria-valuenow", String(getProTierIndex()));
  }

  function initProTierPicker() {
    if (!proPicker || !proRange) return;

    proRange.addEventListener("input", syncProTier);
    proPicker.querySelectorAll(".hf-pro-tier-tick").forEach(function (tick) {
      tick.addEventListener("click", function () {
        const idx = tick.getAttribute("data-tier-index");
        if (idx == null) return;
        proRange.value = idx;
        syncProTier();
      });
    });
    syncProTier();
  }

  function formatCreditsPerMonth(internal) {
    return (internal * CREDIT_RATE).toLocaleString("en-US") + " credits / mo";
  }

  function formatUsd(amount) {
    return "$" + Math.round(amount);
  }

  function syncStrikePrices(isYearly) {
    root.querySelectorAll(".hf-price").forEach(function (box) {
      const amount = box.querySelector(".hf-amount");
      const oldEl = box.querySelector(".hf-old-price");
      if (!amount || !oldEl) return;
      if (amount.classList.contains("papi-pro-pricing")) return;

      const planClass = Object.keys(monthlyPrices).find(function (key) {
        return amount.classList.contains(key);
      });
      if (!planClass) return;

      const monthly = monthlyPrices[planClass];
      oldEl.textContent = isYearly
        ? formatUsd(monthly)
        : formatUsd(monthlyStrikePrices[planClass]);
    });
    syncProTier();
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      if (tab.classList.contains("w--current")) return;
      const isApi = tab.getAttribute("data-hf-tab") === "api";
      tabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle("w--current", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
      root.classList.add("is-switching");
      root.classList.toggle("api-mode", isApi);
      clearTimeout(switchTimer);
      switchTimer = setTimeout(function () {
        root.classList.remove("is-switching");
      }, 450);
    });
  });

  function syncYearlyUi() {
    const isYearly = !!(toggle && toggle.checked);
    root.classList.toggle("is-yearly", isYearly);
    periodTexts.forEach((el) => {
      el.textContent = isYearly ? "per month, billed annually" : "per month";
    });
    syncStrikePrices(isYearly);
  }

  if (toggle) {
    toggle.addEventListener("change", syncYearlyUi);
    syncYearlyUi();
  }

  initProTierPicker();
  window.addEventListener("load", syncProTier);

  function initOfferCountdown() {
    const offer = root.querySelector(".hf-v2-offer");
    if (!offer) return;

    const endKey = "hf-v2-offer-end";
    let end = Number(localStorage.getItem(endKey));
    if (!end || end < Date.now()) {
      end = Date.now() + 24 * 60 * 60 * 1000;
      localStorage.setItem(endKey, String(end));
    }

    const daysEl = root.querySelector(".hf-v2-cd-days");
    const hoursEl = root.querySelector(".hf-v2-cd-hours");
    const minsEl = root.querySelector(".hf-v2-cd-mins");
    const secsEl = root.querySelector(".hf-v2-cd-secs");
    const pad = function (n) {
      return String(n).padStart(2, "0");
    };

    function tick() {
      const diff = Math.max(0, end - Date.now());
      const s = Math.floor(diff / 1000);
      const d = Math.floor(s / 86400);
      const h = Math.floor((s % 86400) / 3600);
      const m = Math.floor((s % 3600) / 60);
      const sec = s % 60;
      if (daysEl) daysEl.textContent = pad(d);
      if (hoursEl) hoursEl.textContent = pad(h);
      if (minsEl) minsEl.textContent = pad(m);
      if (secsEl) secsEl.textContent = pad(sec);
    }

    tick();
    setInterval(tick, 1000);
  }

  initOfferCountdown();
});
})();</script>
  

