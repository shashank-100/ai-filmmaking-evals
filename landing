<script>
function getTrackingCookies() {
  if (!document.cookie) return null;
  const data = document.cookie
    .split("; ")
    .reduce((acc, c) => {
      const [k, ...v] = c.split("=");
      acc[decodeURIComponent(k)] = decodeURIComponent(v.join("="));
      return acc;
    }, {});
  return Object.keys(data).length ? JSON.stringify(data) : null;
}
